<?xml version="1.0"?>
<sdf version="1.6">
<model name="wall_with_pattern">
  <static>true</static>

  <link name="link">

    <visual name="visual">
      <geometry>
        <box>
          <size>5 0.1 3</size>
        </box>
      </geometry>

      <material>
        <script>
          <uri>model://wall_line/materials/scripts</uri>
          <uri>model://wall_line/materials/textures</uri>
          <name>WallPattern/Stripe</name>
        </script>
      </material>

    </visual>

    <collision name="collision">
      <geometry>
        <box>
          <size>5 0.1 3</size>
        </box>
      </geometry>
    </collision>

  </link>
</model>
</sdf>
