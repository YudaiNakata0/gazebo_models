<?xml version="1.0"?>
<sdf version="1.6">
<model name="wall_with_pattern">
  <static>true</static>

  <link name="link">

    <visual name="visual">
      <geometry>
        <box>
          <size>3 0.1 2</size>
        </box>
      </geometry>

      <material>
        <script>
          <uri>model://wall_image/materials/scripts</uri>
          <uri>model://wall_image/materials/textures</uri>
          <name>WallPattern/Stripe</name>
        </script>
      </material>

    </visual>

    <collision name="collision">
      <geometry>
        <box>
          <size>3 0.1 2</size>
        </box>
      </geometry>
    </collision>

  </link>
</model>
</sdf>
